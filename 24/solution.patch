+"use client";
+/* eslint-disable react-hooks/purity */
+/* eslint-disable react-hooks/set-state-in-effect */
+import { useEffect,useState } from "react"; import { apiFetch,ApiError } from "@/lib/client"; import { Empty,ErrorState,Loading } from "@/components/ui";
+type Ride={id:number;originName?:string;destinationName?:string;departureAt:string;status:string;creditPrice:number};type Booking={id:number;status:string;credits?:number;ride?:Ride;host?:{name:string};rider?:{name:string};actions?:string[]};type History={bookings:Booking[];offers:Ride[]};
+export default function Cancellations(){const [data,setData]=useState<History>({bookings:[],offers:[]}),[reasons,setReasons]=useState<Record<string,string>>({}),[error,setError]=useState(""),[loading,setLoading]=useState(true),[pending,setPending]=useState("");const load=()=>{setLoading(true);void apiFetch<History>("/api/cancellations").then(x=>setData({bookings:x.bookings??[],offers:x.offers??[]})).catch((e:unknown)=>setError(e instanceof ApiError?e.message:"Unable to load cancellation history.")).finally(()=>setLoading(false))};useEffect(()=>{load()},[]);async function cancel(url:string,key:string){setPending(key);setError("");try{await apiFetch(url,{method:"POST",body:JSON.stringify({reason:reasons[key]??"Changed plans"})});load()}catch(e:unknown){setError(e instanceof ApiError?e.message:"Cancellation could not be completed.")}finally{setPending("")}}const reason=(key:string)=><input aria-label="Cancellation reason" maxLength={200} placeholder="Reason (optional)" value={reasons[key]??""} onChange={e=>setReasons({...reasons,[key]:e.target.value})}/>;return <><div className="eyebrow">CANCELLATIONS</div><h1 className="page-title">Cancellations</h1><p className="lede">Cancel future requests, accepted bookings, or whole rides you host. Refunds and seat restoration are handled transactionally.</p>{error&&<ErrorState message={error}/>} {loading?<Loading/>:<><div className="section-head"><h2>Bookings</h2></div>{data.bookings.length===0?<Empty>No future booking cancellations are available.</Empty>:<div className="list">{data.bookings.map(b=><div className="list-row" key={`b-${b.id}`}><div><strong>{b.ride?.originName??"Campus stop"} → {b.ride?.destinationName??"Campus stop"}</strong><div className="muted">{b.ride?.departureAt?new Date(b.ride.departureAt).toLocaleString("en-IN",{timeZone:"Asia/Kolkata"}):"Date unavailable"} · {b.status}</div></div>{b.actions?.includes("CANCEL")&&<div className="actions">{reason(`b-${b.id}`)}<button className="button danger" disabled={pending===`b-${b.id}`} onClick={()=>cancel(`/api/bookings/${b.id}/cancel`,`b-${b.id}`)}>{pending===`b-${b.id}`?"Cancelling…":"Cancel booking"}</button></div>}</div>)}</div>}<div className="section-head"><h2>Published rides</h2></div>{data.offers.length===0?<Empty>No future hosted rides are available.</Empty>:<div className="list">{data.offers.map(o=><div className="list-row" key={`o-${o.id}`}><div><strong>{o.originName??"Campus stop"} → {o.destinationName??"Campus stop"}</strong><div className="muted">{new Date(o.departureAt).toLocaleString("en-IN",{timeZone:"Asia/Kolkata"})} · {o.status}</div></div>{o.status==="PUBLISHED"&&new Date(o.departureAt).getTime()>Date.now()&&<div className="actions">{reason(`o-${o.id}`)}<button className="button danger" disabled={pending===`o-${o.id}`} onClick={()=>cancel(`/api/offers/${o.id}/cancel`,`o-${o.id}`)}>{pending===`o-${o.id}`?"Cancelling…":"Cancel whole ride"}</button></div>}</div>)}</div>}</>}</>}
