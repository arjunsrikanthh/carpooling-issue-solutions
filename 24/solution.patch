+import type {PoolConnection} from 'mysql2/promise';
+import {body,emit,HttpError,id,idempotent,key,reasonInput,requireUser} from './core';
+import {exec,pool,rows} from './db';
+import {bookingDto} from './booking-view';
+import {publicRide,RIDE_SELECT,utcDate} from './quote';
+import type {BookingRow,RideRow} from './types';
+async function refund(cx:PoolConnection,booking:BookingRow){const hold=(await rows<{amount:number;user_id:number}>(cx,"SELECT amount,user_id FROM ledger WHERE booking_id=? AND kind='HOLD'",[booking.id]))[0];if(!hold)throw new Error('Accepted booking has no hold');await exec(cx,"INSERT INTO ledger(user_id,booking_id,kind,amount) VALUES(?,?,'REFUND',?)",[hold.user_id,booking.id,hold.amount]);await exec(cx,'UPDATE users SET credits=credits+? WHERE id=?',[hold.amount,hold.user_id]);return hold.amount;}
+function cancellable(ride:RideRow){if(ride.status!=='PUBLISHED'||utcDate(ride.departure_at).getTime()<=Date.now())throw new HttpError(409,'CANCELLATION_WINDOW_CLOSED');}
+export async function cancelBooking(request:Request,rawId:string){const actor=await requireUser(request);const bookingId=id(rawId);const input=await body(request,reasonInput);return idempotent(actor.id,key(request),'booking.cancel:'+bookingId,input,async cx=>{const ref=(await rows<{ride_id:number}>(cx,'SELECT ride_id FROM bookings WHERE id=?',[bookingId]))[0];if(!ref)throw new HttpError(404,'BOOKING_NOT_FOUND');const ride=(await rows<RideRow>(cx,'SELECT * FROM rides WHERE id=? FOR UPDATE',[ref.ride_id]))[0];const b=(await rows<BookingRow>(cx,'SELECT * FROM bookings WHERE id=? FOR UPDATE',[bookingId]))[0];if(actor.id!==ride.driver_id&&actor.id!==b.rider_id)throw new HttpError(403,'PARTICIPANT_REQUIRED');cancellable(ride);if(!['REQUESTED','ACCEPTED'].includes(b.status))throw new HttpError(409,'BOOKING_ALREADY_CLOSED');let refunded=0;if(b.status==='ACCEPTED'){refunded=await refund(cx,b);await exec(cx,'UPDATE rides SET seats_available=seats_available+1 WHERE id=?',[ride.id]);}await exec(cx,"UPDATE bookings SET status='CANCELLED',cancelled_by=?,cancellation_reason=? WHERE id=?",[actor.id,input.reason??null,b.id]);await emit(cx,{type:'booking.cancelled',actorId:actor.id,audienceIds:[ride.driver_id,b.rider_id],rideId:ride.id,bookingId:b.id,data:{status:'CANCELLED',refundedCredits:refunded}});return bookingDto(cx,b.id,actor.id);});}
+export async function cancelOffer(request:Request,rawId:string){const actor=await requireUser(request);const rideId=id(rawId);const input=await body(request,reasonInput);return idempotent(actor.id,key(request),'ride.cancel:'+rideId,input,async cx=>{const ride=(await rows<RideRow>(cx,'SELECT * FROM rides WHERE id=? FOR UPDATE',[rideId]))[0];if(!ride)throw new HttpError(404,'RIDE_NOT_FOUND');if(ride.driver_id!==actor.id)throw new HttpError(403,'HOST_REQUIRED');cancellable(ride);const bookings=await rows<BookingRow>(cx,"SELECT * FROM bookings WHERE ride_id=? AND status IN ('REQUESTED','ACCEPTED') ORDER BY rider_id,id FOR UPDATE",[ride.id]);for(const b of bookings){let refunded=0;if(b.status==='ACCEPTED')refunded=await refund(cx,b);await exec(cx,"UPDATE bookings SET status='CANCELLED',cancelled_by=?,cancellation_reason=? WHERE id=?",[actor.id,input.reason??null,b.id]);await emit(cx,{type:'booking.cancelled',actorId:actor.id,audienceIds:[b.rider_id],rideId:ride.id,bookingId:b.id,data:{status:'CANCELLED',refundedCredits:refunded,wholeRide:true}});}await exec(cx,"UPDATE rides SET status='CANCELLED',seats_available=total_seats WHERE id=?",[ride.id]);await emit(cx,{type:'ride.cancelled',actorId:actor.id,audienceIds:bookings.map(b=>b.rider_id),rideId:ride.id,data:{status:'CANCELLED',bookingsCancelled:bookings.length}});const result=(await rows<RideRow>(cx,RIDE_SELECT+' WHERE r.id=?',[ride.id]))[0];return {...publicRide(result),bookingsCancelled:bookings.length};});}
+
+export async function cancellationHistory(request:Request){const user=await requireUser(request);const ids=await rows<{id:number}>(pool(),'SELECT b.id FROM bookings b JOIN rides r ON r.id=b.ride_id WHERE b.rider_id=? OR r.driver_id=? ORDER BY b.id DESC LIMIT 200',[user.id,user.id]);const bookings=await Promise.all(ids.map(b=>bookingDto(pool(),b.id,user.id)));const offers=(await rows<RideRow>(pool(),RIDE_SELECT+' WHERE r.driver_id=? ORDER BY r.departure_at DESC LIMIT 200',[user.id])).map(publicRide);return {bookings,offers};}
diff --git a/campuspool/tests/issue-24.test.ts b/campuspool/tests/issue-24.test.ts
