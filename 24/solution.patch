@@ -0,0 +1,13 @@
+import {afterAll,describe,expect,it} from 'vitest';
+import {randomUUID} from 'node:crypto';
+import {exec,pool,rows,transaction} from '../src/server/db';
+import {cancelBooking,cancelOffer} from '../src/server/cancellations';
+import {reasonInput} from '../src/server/core';
+import {fixtureRide,fixtureUser,integration} from './support';
+it('bounds cancellation reasons',()=>{expect(reasonInput.safeParse({reason:'x'.repeat(201)}).success).toBe(false);});
+describe.skipIf(!integration)('cancellation independent real SQL transactions',()=>{
+ afterAll(async()=>{await pool().end();});
+ async function acceptedFixture(){const host=await fixtureUser('DRIVER'),rider=await fixtureUser(),ride=await fixtureRide(host.user);const b=await transaction(async cx=>{const b=await exec(cx,"INSERT INTO bookings(ride_id,rider_id,status) VALUES(?,?,'ACCEPTED')",[ride.id,rider.user.id]);await exec(cx,'UPDATE rides SET seats_available=0 WHERE id=?',[ride.id]);await exec(cx,'UPDATE users SET credits=975 WHERE id=?',[rider.user.id]);await exec(cx,"INSERT INTO ledger(user_id,booking_id,kind,amount) VALUES(?,?,'HOLD',25)",[rider.user.id,b.insertId]);return b.insertId;});return {host,rider,ride,b};}
+ it('refunds once under simultaneous rider,host,and whole-ride cancellation',async()=>{for(let i=0;i<6;i++){const f=await acceptedFixture();const results=await Promise.allSettled([cancelBooking(f.rider.request('POST',{reason:'Changed plans'}),String(f.b)),cancelBooking(f.host.request('POST',{}),String(f.b)),cancelOffer(f.host.request('POST',{reason:'Host cancelled'}),String(f.ride.id))]);expect(results.some(r=>r.status==='fulfilled')).toBe(true);expect((await rows<{credits:number}>(pool(),'SELECT credits FROM users WHERE id=?',[f.rider.user.id]))[0].credits).toBe(1000);expect(await rows(pool(),"SELECT id FROM ledger WHERE booking_id=? AND kind='REFUND'",[f.b])).toHaveLength(1);expect((await rows<{seats_available:number}>(pool(),'SELECT seats_available FROM rides WHERE id=?',[f.ride.id]))[0].seats_available).toBe(1);expect((await rows<{status:string}>(pool(),'SELECT status FROM bookings WHERE id=?',[f.b]))[0].status).toBe('CANCELLED');}});
+ it('replays the same cancellation response, preserves reason, and rejects outsiders',async()=>{const f=await acceptedFixture();const outsider=await fixtureUser();await expect(cancelBooking(outsider.request('POST',{}),String(f.b))).rejects.toMatchObject({status:403});const key=randomUUID();const result=await cancelBooking(f.rider.request('POST',{reason:'Test reason'},key),String(f.b));expect(await cancelBooking(f.rider.request('POST',{reason:'Test reason'},key),String(f.b))).toEqual(result);await expect(cancelBooking(f.rider.request('POST',{}),String(f.b))).rejects.toMatchObject({status:409});expect(result.cancellationReason).toBe('Test reason');});
+});
