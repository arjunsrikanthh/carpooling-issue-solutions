+"use client";
+import Link from "next/link"; import { useEffect,useState } from "react"; import { apiFetch } from "@/lib/client"; import { useSession } from "@/components/AppShell"; import { Empty,ErrorState,Loading } from "@/components/ui";
+type Booking={id:number;status:string;credits?:number;ride?:{originName?:string;destinationName?:string;departureAt:string};host?:{name:string};rider?:{name:string};actions?:string[]};
+export default function Bookings(){const {features}=useSession();const canCancel=features.includes("cancellations");const [items,setItems]=useState<Booking[]>([]),[error,setError]=useState(""),[loading,setLoading]=useState(true);const load=()=>{setLoading(true);void apiFetch<Booking[]>("/api/bookings").then(setItems).catch((e:unknown)=>setError(e instanceof Error?e.message:"Could not load bookings.")).finally(()=>setLoading(false))};useEffect(()=>{load()},[]);async function decision(id:number,decision:"ACCEPT"|"REJECT"){try{await apiFetch(`/api/bookings/${id}/decision`,{method:"POST",body:JSON.stringify({decision})});load()}catch(e:unknown){setError(e instanceof Error?e.message:"Unable to update booking.")}}async function cancel(id:number){try{await apiFetch(`/api/bookings/${id}/cancel`,{method:"POST",body:JSON.stringify({reason:"Changed plans"})});load()}catch(e:unknown){setError(e instanceof Error?e.message:"Unable to cancel booking.")}}return <><div className="section-head"><div><div className="eyebrow">BOOKINGS</div><h1 className="page-title">Bookings</h1><p className="lede">Requests, decisions, and credit holds in one place.</p></div></div>{error&&<ErrorState message={error}/>} {loading?<Loading/>:items.length===0?<Empty>No booking requests yet. <Link href="/rides">Find a ride →</Link></Empty>:<div className="list">{items.map(b=><div className="list-row" key={b.id}><div><strong>{b.ride?.originName??"Campus stop"} → {b.ride?.destinationName??"Campus stop"}</strong><div className="muted">{b.ride?.departureAt?new Date(b.ride.departureAt).toLocaleString("en-IN",{timeZone:"Asia/Kolkata"}):"Date unavailable"} · {b.host?.name??b.rider?.name??"Member"} {b.credits?`· ${b.credits} credits`:""}</div></div><div className="actions"><span className={`status ${b.status}`}>{b.status}</span>{b.actions?.includes("ACCEPT")&&<button className="button" onClick={()=>decision(b.id,"ACCEPT")}>Accept</button>}{b.actions?.includes("REJECT")&&<button className="button ghost" onClick={()=>decision(b.id,"REJECT")}>Reject</button>}{canCancel&&b.actions?.includes("CANCEL")&&<button className="button danger" onClick={()=>cancel(b.id)}>Cancel</button>}</div></div>)}</div>}</>}
