+import {afterAll,describe,expect,it} from 'vitest';
+import {randomUUID} from 'node:crypto';
+import {pool,exec,rows} from '../src/server/db';
+import {issueQuote} from '../src/server/quote';
+import {bookingInput,requestBooking,decideBooking} from '../src/server/bookings';
+import {fixtureRide,fixtureUser,integration} from './support';
+it('rejects malformed booking input',()=>{expect(bookingInput.safeParse({rideId:-1,quoteToken:''}).success).toBe(false);});
+describe.skipIf(!integration)('booking real SQL transactions',()=>{
+ afterAll(async()=>{await pool().end();});
+ it('requests one seat, restricts participants and atomically holds credits',async()=>{const host=await fixtureUser('DRIVER'),rider=await fixtureUser(),foreign=await fixtureUser();const ride=await fixtureRide(host.user);const payload={rideId:ride.id,quoteToken:issueQuote(rider.user.id,ride)};const key=randomUUID();const b=await requestBooking(rider.request('POST',payload,key));expect(b.status).toBe('REQUESTED');expect((await requestBooking(rider.request('POST',payload,key))).id).toBe(b.id);await expect(requestBooking(rider.request('POST',payload))).rejects.toMatchObject({status:409});await expect(decideBooking(foreign.request('POST',{decision:'ACCEPT'}),String(b.id))).rejects.toMatchObject({status:403});const accepted=await decideBooking(host.request('POST',{decision:'ACCEPT'}),String(b.id));expect(accepted.status).toBe('ACCEPTED');const user=await rows<{credits:number}>(pool(),'SELECT credits FROM users WHERE id=?',[rider.user.id]);expect(user[0].credits).toBe(975);expect((await rows<{seats_available:number}>(pool(),'SELECT seats_available FROM rides WHERE id=?',[ride.id]))[0].seats_available).toBe(0);expect(await rows(pool(),"SELECT id FROM ledger WHERE booking_id=? AND kind='HOLD'",[b.id])).toHaveLength(1);});
+ it('rejects changed terms and insufficient credits with no partial seat or ledger write',async()=>{const host=await fixtureUser('DRIVER'),rider=await fixtureUser();const ride=await fixtureRide(host.user);const quote=issueQuote(rider.user.id,ride);await exec(pool(),'UPDATE rides SET credit_price=26 WHERE id=?',[ride.id]);await expect(requestBooking(rider.request('POST',{rideId:ride.id,quoteToken:quote}))).rejects.toMatchObject({code:'STALE_QUOTE'});await exec(pool(),'UPDATE rides SET credit_price=25 WHERE id=?',[ride.id]);const b=await requestBooking(rider.request('POST',{rideId:ride.id,quoteToken:quote}));await exec(pool(),'UPDATE users SET credits=0 WHERE id=?',[rider.user.id]);await expect(decideBooking(host.request('POST',{decision:'ACCEPT'}),String(b.id))).rejects.toMatchObject({code:'INSUFFICIENT_CREDITS'});expect((await rows<{status:string}>(pool(),'SELECT status FROM bookings WHERE id=?',[b.id]))[0].status).toBe('REQUESTED');expect((await rows<{seats_available:number}>(pool(),'SELECT seats_available FROM rides WHERE id=?',[ride.id]))[0].seats_available).toBe(1);expect(await rows(pool(),'SELECT id FROM ledger WHERE booking_id=?',[b.id])).toHaveLength(0);});
+ it('allows exactly one winner in repeated final-seat acceptance races',async()=>{for(let i=0;i<6;i++){const host=await fixtureUser('DRIVER'),one=await fixtureUser(),two=await fixtureUser();const ride=await fixtureRide(host.user);const bookings=await Promise.all([one,two].map(f=>requestBooking(f.request('POST',{rideId:ride.id,quoteToken:issueQuote(f.user.id,ride)}))));const results=await Promise.allSettled(bookings.map(b=>decideBooking(host.request('POST',{decision:'ACCEPT'}),String(b.id))));expect(results.filter(r=>r.status==='fulfilled')).toHaveLength(1);expect(results.filter(r=>r.status==='rejected')).toHaveLength(1);expect((await rows<{n:number}>(pool(),"SELECT COUNT(*) n FROM bookings WHERE ride_id=? AND status='ACCEPTED'",[ride.id]))[0].n).toBe(1);expect((await rows<{seats_available:number}>(pool(),'SELECT seats_available FROM rides WHERE id=?',[ride.id]))[0].seats_available).toBe(0);}});
+});
