@@ -0,0 +1,12 @@
+import {z} from 'zod';
+import {body,emit,HttpError,id,idempotent,key,requireUser} from './core';
+import {exec,pool,rows} from './db';
+import {RIDE_SELECT,utcDate,verifyQuote} from './quote';
+import {bookingDto} from './booking-view';
+import type {BookingRow,RideRow,User} from './types';
+export const bookingInput=z.object({rideId:z.number().int().positive(),quoteToken:z.string().min(1).max(2048)}).strict();
+export const decisionInput=z.object({decision:z.enum(['ACCEPT','REJECT'])}).strict();
+function eligible(ride:RideRow){if(ride.status!=='PUBLISHED'||utcDate(ride.departure_at).getTime()<=Date.now())throw new HttpError(409,'RIDE_UNAVAILABLE');if(ride.driver_status!=='APPROVED'||ride.vehicle_status!=='APPROVED')throw new HttpError(409,'RIDE_UNAVAILABLE');}
+export async function listBookings(request:Request){const user=await requireUser(request);const ids=await rows<{id:number}>(pool(),'SELECT b.id FROM bookings b JOIN rides r ON r.id=b.ride_id WHERE b.rider_id=? OR r.driver_id=? ORDER BY b.id DESC LIMIT 200',[user.id,user.id]);return Promise.all(ids.map(b=>bookingDto(pool(),b.id,user.id)));}
+export async function requestBooking(request:Request){const user=await requireUser(request);if(user.role==='ADMIN')throw new HttpError(403,'MEMBER_REQUIRED');const input=await body(request,bookingInput);return idempotent(user.id,key(request),'booking.request',input,async cx=>{const exists=(await rows<{id:number}>(cx,'SELECT id FROM rides WHERE id=? FOR UPDATE',[input.rideId]))[0];if(!exists)throw new HttpError(404,'RIDE_NOT_FOUND');const ride=(await rows<RideRow>(cx,RIDE_SELECT+' WHERE r.id=?',[input.rideId]))[0];if(ride.driver_id===user.id)throw new HttpError(403,'SELF_BOOKING_FORBIDDEN');eligible(ride);verifyQuote(input.quoteToken,user.id,ride);if(ride.seats_available<1)throw new HttpError(409,'RIDE_FULL');const active=(await rows<{id:number}>(cx,"SELECT id FROM bookings WHERE ride_id=? AND rider_id=? AND status IN ('REQUESTED','ACCEPTED')",[ride.id,user.id]))[0];if(active)throw new HttpError(409,'DUPLICATE_BOOKING');const created=await exec(cx,"INSERT INTO bookings(ride_id,rider_id,status) VALUES(?,?,'REQUESTED')",[ride.id,user.id]);await emit(cx,{type:'booking.requested',actorId:user.id,audienceIds:[ride.driver_id],rideId:ride.id,bookingId:created.insertId,data:{status:'REQUESTED'}});return bookingDto(cx,created.insertId,user.id);});}
+export async function decideBooking(request:Request,rawId:string){const actor=await requireUser(request);const bookingId=id(rawId);const input=await body(request,decisionInput);return idempotent(actor.id,key(request),'booking.decision:'+bookingId,input,async cx=>{const ref=(await rows<{ride_id:number}>(cx,'SELECT ride_id FROM bookings WHERE id=?',[bookingId]))[0];if(!ref)throw new HttpError(404,'BOOKING_NOT_FOUND');const locked=(await rows<RideRow>(cx,'SELECT * FROM rides WHERE id=? FOR UPDATE',[ref.ride_id]))[0];if(locked.driver_id!==actor.id)throw new HttpError(403,'HOST_REQUIRED');const b=(await rows<BookingRow>(cx,'SELECT * FROM bookings WHERE id=? FOR UPDATE',[bookingId]))[0];const ride=(await rows<RideRow>(cx,RIDE_SELECT+' WHERE r.id=?',[ref.ride_id]))[0];eligible(ride);if(b.status!=='REQUESTED')throw new HttpError(409,'BOOKING_ALREADY_DECIDED');if(input.decision==='REJECT'){await exec(cx,"UPDATE bookings SET status='REJECTED' WHERE id=?",[bookingId]);await emit(cx,{type:'booking.rejected',actorId:actor.id,audienceIds:[b.rider_id],rideId:ride.id,bookingId,data:{status:'REJECTED'}});return bookingDto(cx,bookingId,actor.id);}if(ride.seats_available<1)throw new HttpError(409,'RIDE_FULL');const rider=(await rows<User>(cx,'SELECT id,credits,status FROM users WHERE id=? FOR UPDATE',[b.rider_id]))[0];if(rider.status!=='APPROVED')throw new HttpError(409,'RIDER_UNAPPROVED');if(rider.credits<ride.credit_price)throw new HttpError(409,'INSUFFICIENT_CREDITS');const seats=await exec(cx,"UPDATE rides SET seats_available=seats_available-1 WHERE id=? AND status='PUBLISHED' AND seats_available>0",[ride.id]);if(seats.affectedRows!==1)throw new HttpError(409,'RIDE_FULL');await exec(cx,'UPDATE users SET credits=credits-? WHERE id=?',[ride.credit_price,b.rider_id]);await exec(cx,"INSERT INTO ledger(user_id,booking_id,kind,amount) VALUES(?,?,'HOLD',?)",[b.rider_id,bookingId,ride.credit_price]);await exec(cx,"UPDATE bookings SET status='ACCEPTED' WHERE id=?",[bookingId]);await emit(cx,{type:'booking.accepted',actorId:actor.id,audienceIds:[b.rider_id],rideId:ride.id,bookingId,data:{status:'ACCEPTED',creditsHeld:ride.credit_price}});return bookingDto(cx,bookingId,actor.id);});}
