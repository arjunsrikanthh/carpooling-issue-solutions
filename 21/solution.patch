+"use client";
+import { useEffect,useState } from "react"; import { apiFetch } from "@/lib/client"; import { Empty,ErrorState,FormButton,Loading,useSubmit } from "@/components/ui";
+type Stop={id:number;name:string};type Vehicle={id:number;kind:string;model:string;passengerCapacity:number};type Offer={id:number;originName?:string;destinationName?:string;departureAt:string;creditPrice:number;seatsAvailable:number;status:string;vehicle?:{kind?:string}};
+type Form={vehicleId:string;originStopId:string;destinationStopId:string;departureAt:string;totalSeats:string;creditPrice:string};
+function toCampusOffset(local:string){return `${local}:00+05:30`}
+export default function Offers(){const [catalog,setCatalog]=useState<{stops:Stop[];vehicles:Vehicle[]}>({stops:[],vehicles:[]}),[offers,setOffers]=useState<Offer[]>([]),[error,setError]=useState(""),[loading,setLoading]=useState(true);const [form,setForm]=useState<Form>({vehicleId:"",originStopId:"",destinationStopId:"",departureAt:"",totalSeats:"1",creditPrice:"1"});const {submit,saving,error:saveError}=useSubmit("/api/offers");useEffect(()=>{void Promise.all([apiFetch<typeof catalog>("/api/catalog"),apiFetch<Offer[]>("/api/offers")]).then(([c,o])=>{setCatalog(c);setOffers(o)}).catch((e:unknown)=>setError(e instanceof Error?e.message:"Unable to load offers.")).finally(()=>setLoading(false))},[]);async function add(e:React.FormEvent){e.preventDefault();try{await submit({vehicleId:Number(form.vehicleId),originStopId:Number(form.originStopId),destinationStopId:Number(form.destinationStopId),departureAt:toCampusOffset(form.departureAt),totalSeats:Number(form.totalSeats),creditPrice:Number(form.creditPrice)});const refreshed=await apiFetch<Offer[]>("/api/offers");setOffers(refreshed);setForm({...form,departureAt:""})}catch{}}return <><div className="section-head"><div><div className="eyebrow">OFFERS</div><h1 className="page-title">Publish a ride</h1><p className="lede">Choose an approved vehicle and two different campus stops. Times are interpreted in Asia/Kolkata.</p></div></div>{error&&<ErrorState message={error}/>}<div className="split"><section>{loading?<Loading/>:offers.length===0?<Empty>Your published rides will appear here.</Empty>:<div className="list">{offers.map(o=><div className="list-row" key={o.id}><div><strong>{o.originName??"Origin"} → {o.destinationName??"Destination"}</strong><div className="muted">{new Date(o.departureAt).toLocaleString("en-IN",{timeZone:"Asia/Kolkata"})} · {o.creditPrice} credits · {o.seatsAvailable} seats left</div></div><span className={`status ${o.status}`}>{o.status}</span></div>)}</div>}</section><form className="card" onSubmit={add}><h2>Ride details</h2>{saveError&&<p className="form-error" role="alert">{saveError}</p>}<div className="field"><label htmlFor="vehicle">Approved vehicle</label><select id="vehicle" required value={form.vehicleId} onChange={e=>setForm({...form,vehicleId:e.target.value})}><option value="">Select vehicle</option>{catalog.vehicles.map(v=><option key={v.id} value={v.id}>{v.model} · {v.kind}</option>)}</select></div><div className="field"><label htmlFor="origin">From</label><select id="origin" required value={form.originStopId} onChange={e=>setForm({...form,originStopId:e.target.value})}><option value="">Select stop</option>{catalog.stops.map(s=><option key={s.id} value={s.id}>{s.name}</option>)}</select></div><div className="field"><label htmlFor="destination">To</label><select id="destination" required value={form.destinationStopId} onChange={e=>setForm({...form,destinationStopId:e.target.value})}><option value="">Select stop</option>{catalog.stops.map(s=><option key={s.id} value={s.id}>{s.name}</option>)}</select></div><div className="field"><label htmlFor="departure">Departure · Asia/Kolkata</label><input id="departure" type="datetime-local" required value={form.departureAt} onChange={e=>setForm({...form,departureAt:e.target.value})}/></div><div className="field"><label htmlFor="seats">Passenger seats</label><input id="seats" type="number" min="1" max="5" required value={form.totalSeats} onChange={e=>setForm({...form,totalSeats:e.target.value})}/></div><div className="field"><label htmlFor="price">Credit price</label><input id="price" type="number" min="1" max="1000" required value={form.creditPrice} onChange={e=>setForm({...form,creditPrice:e.target.value})}/></div><FormButton disabled={saving}>Publish offer</FormButton></form></div></>}
