diff --git a/prototype/tests/extension/MobilitySearchRegressionTest.php b/prototype/tests/extension/MobilitySearchRegressionTest.php
new file mode 100644
index 0000000..c3942e8
--- /dev/null
+++ b/prototype/tests/extension/MobilitySearchRegressionTest.php
@@ -0,0 +1,120 @@
+<?php
+
+namespace Tests\Feature\Mobility;
+
+use Illuminate\Support\Facades\DB;
+use STS\Mobility\Pickup\PathProvider;
+use STS\Models\User;
+use STS\Models\Passenger;
+use Tests\TestCase;
+
+/**
+ * Issue #43 regression coverage for search filters and input boundaries.
+ *
+ * The broader product suite covers the happy path. These tests deliberately
+ * mutate publication/lifecycle state so search cannot accidentally expose a
+ * cancelled, unpublished, or exhausted offer.
+ */
+final class MobilitySearchRegressionTest extends TestCase
+{
+    protected function beforeRefreshingDatabase(): void
+    {
+        $name = DB::connection()->getDatabaseName();
+        if (! preg_match('/^testing[a-zA-Z0-9_-]*$/', $name)) {
+            throw new \RuntimeException('Refusing to refresh non-test database: '.$name);
+        }
+    }
+
+    protected function setUp(): void
+    {
+        parent::setUp();
+        putenv('MOBILITY_PILOT_UI_ENABLED=true');
+        putenv('MOBILITY_COLLEGE_CODE=CAMPUS-BLR');
+        foreach (['car', 'bike', 'foot'] as $mode) {
+            config(['mobility_routing.'.$mode.'_expected_data_version' => $mode.'|crop_sha256='.str_repeat('a', 64).'|profile_sha256='.str_repeat('b', 64)]);
+        }
+        app()->bind(PathProvider::class, fn () => new class implements PathProvider {
+            public function path(array $points, string $mode, float $timeoutSeconds = 5): array
+            {
+                $legs = [];
+                for ($i = 1; $i < count($points); $i++) {
+                    $distance = (int) round(hypot(($points[$i]['lat'] - $points[$i - 1]['lat']) * 111000, ($points[$i]['lng'] - $points[$i - 1]['lng']) * 100000));
+                    $legs[] = ['distance_meters' => $distance, 'duration_seconds' => $distance ? (int) ceil($distance / 8) : 0];
+                }
+                return ['provider' => 'osrm', 'profile' => $mode, 'data_version' => $mode.'|crop_sha256='.str_repeat('a', 64).'|profile_sha256='.str_repeat('b', 64), 'geometry' => array_map(fn ($point) => [$point['lng'], $point['lat']], $points), 'waypoints' => array_map(fn ($point) => ['location' => [$point['lng'], $point['lat']], 'distance_meters' => 0], $points), 'legs' => $legs, 'distance_meters' => array_sum(array_column($legs, 'distance_meters')), 'duration_seconds' => array_sum(array_column($legs, 'duration_seconds'))];
+            }
+        });
+    }
+
+    private function demo(string $role): User
+    {
+        return User::findOrFail($this->postJson('/api/mobility/commute/demo-session', ['role' => $role])->assertOk()->json('user.id'));
+    }
+
+    private function profile(string $role): array
+    {
+        return ['role' => $role, 'vehicle_preference' => 'both', 'schedule_mode' => 'fixed', 'home' => ['lat' => 12.9716, 'lng' => 77.5946, 'label' => 'Home'], 'campus' => ['lat' => 12.9352, 'lng' => 77.62, 'label' => 'Campus'], 'outbound_time' => '08:30', 'return_time' => '17:30', 'weekdays' => [1, 2, 3, 4, 5]];
+    }
+
+    public function test_search_rejects_missing_and_malformed_boundaries(): void
+    {
+        $rider = $this->demo('rider');
+        $this->actingAsApiUser($rider)->getJson('/api/mobility/commute/rides')->assertStatus(422);
+        $date = now('Asia/Kolkata')->addDay()->toDateString();
+        $this->actingAsApiUser($rider)->getJson('/api/mobility/commute/rides?direction=sideways&date='.$date.'&start_time=08:00&end_time=09:00&vehicle_type=car')->assertStatus(422);
+        $this->actingAsApiUser($rider)->getJson('/api/mobility/commute/rides?direction=outbound&date=2026-02-30&start_time=08:00&end_time=09:00&vehicle_type=car')->assertStatus(422);
+    }
+
+    public function test_search_excludes_cancelled_and_unpublished_offers(): void
+    {
+        $rider = $this->demo('rider');
+        $driver = $this->demo('driver');
+        foreach ([[$rider, 'rider'], [$driver, 'driver']] as [$user, $role]) {
+            $this->actingAsApiUser($user)->putJson('/api/mobility/commute/profile', $this->profile($role))->assertOk();
+        }
+        $date = now('Asia/Kolkata')->addDay()->toDateString();
+        $trip = $this->actingAsApiUser($driver)->postJson('/api/mobility/commute/offers', ['date' => $date, 'direction' => 'outbound', 'vehicle_type' => 'car', 'choice' => 'DIRECT_RIDER_PICKUP'], ['Idempotency-Key' => 'search-regression'])->assertOk()->json('data.trip_id');
+        $query = '/api/mobility/commute/rides?direction=outbound&date='.$date.'&start_time=08:00&end_time=09:00&vehicle_type=car';
+        $this->actingAsApiUser($rider)->getJson($query)->assertOk()->assertJsonCount(1, 'data');
+        DB::table('mobility_trip_lifecycles')->where('trip_id', $trip)->update(['state' => 'cancelled']);
+        $this->actingAsApiUser($rider)->getJson($query)->assertOk()->assertJsonCount(0, 'data');
+        DB::table('mobility_trip_lifecycles')->where('trip_id', $trip)->update(['state' => 'planned']);
+        DB::table('mobility_commute_demo_trips')->where('trip_id', $trip)->update(['is_publication' => false]);
+        $this->actingAsApiUser($rider)->getJson($query)->assertOk()->assertJsonCount(0, 'data');
+    }
+
+    public function test_search_window_is_inclusive_and_full_rides_are_hidden(): void
+    {
+        $rider = $this->demo('rider');
+        $driver = $this->demo('driver');
+        foreach ([[$rider, 'rider'], [$driver, 'driver']] as [$user, $role]) {
+            $this->actingAsApiUser($user)->putJson('/api/mobility/commute/profile', $this->profile($role))->assertOk();
+        }
+        $date = now('Asia/Kolkata')->addDay()->toDateString();
+        $trip = $this->actingAsApiUser($driver)->postJson('/api/mobility/commute/offers', ['date' => $date, 'direction' => 'outbound', 'vehicle_type' => 'car', 'choice' => 'DIRECT_RIDER_PICKUP'], ['Idempotency-Key' => 'inclusive-window'])->assertOk()->json('data.trip_id');
+        $query = '/api/mobility/commute/rides?direction=outbound&date='.$date.'&start_time=08:30&end_time=08:30&vehicle_type=car';
+        $this->actingAsApiUser($rider)->getJson($query)->assertOk()->assertJsonCount(1, 'data');
+        $seatHolder = $this->demo('rider');
+        Passenger::factory()->aceptado()->create(['trip_id' => $trip, 'user_id' => $seatHolder->id]);
+        $this->actingAsApiUser($rider)->getJson($query)->assertOk()->assertJsonCount(0, 'data');
+    }
+
+    public function test_provider_failure_fails_closed_and_reports_exclusion(): void
+    {
+        $rider = $this->demo('rider');
+        $driver = $this->demo('driver');
+        foreach ([[$rider, 'rider'], [$driver, 'driver']] as [$user, $role]) {
+            $this->actingAsApiUser($user)->putJson('/api/mobility/commute/profile', $this->profile($role))->assertOk();
+        }
+        $date = now('Asia/Kolkata')->addDay()->toDateString();
+        $this->actingAsApiUser($driver)->postJson('/api/mobility/commute/offers', ['date' => $date, 'direction' => 'outbound', 'vehicle_type' => 'car', 'choice' => 'DIRECT_RIDER_PICKUP'], ['Idempotency-Key' => 'provider-failure'])->assertOk();
+        app()->bind(PathProvider::class, fn () => new class implements PathProvider {
+            public function path(array $points, string $mode, float $timeoutSeconds = 5): array
+            {
+                throw new \STS\Mobility\Routing\RoutingException('ROUTE_PROVIDER_UNAVAILABLE');
+            }
+        });
+        $query = '/api/mobility/commute/rides?direction=outbound&date='.$date.'&start_time=08:00&end_time=09:00&vehicle_type=car';
+        $this->actingAsApiUser($rider)->getJson($query)->assertOk()->assertJsonCount(0, 'data')->assertJsonPath('excluded.0.reason', 'ROUTE_PROVIDER_UNAVAILABLE');
+    }
+}
