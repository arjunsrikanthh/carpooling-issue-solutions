new file mode 100644
index 0000000..6fad77c
--- /dev/null
+++ b/prototype/campuspool-extension/Mobility/Recurrence/RecurrenceCreationContext.php
@@ -0,0 +1,24 @@
+<?php
+
+namespace STS\Mobility\Recurrence;
+
+/** Server-only scope for the bounded batch of dated program occurrences. */
+final class RecurrenceCreationContext
+{
+    private static int $depth = 0;
+
+    public static function run(callable $work): mixed
+    {
+        self::$depth++;
+        try {
+            return $work();
+        } finally {
+            self::$depth--;
+        }
+    }
+
+    public static function active(): bool
+    {
+        return self::$depth > 0;
+    }
+}
