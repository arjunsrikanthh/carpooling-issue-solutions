+<?php
+declare(strict_types=1);
+
+// Issue #24 evidence: two HTTP cancellation requests for one paid booking.
+// Runs only against the disposable MySQL/demo stack and never prints tokens.
+require '/var/www/vendor/autoload.php';
+$app = require '/var/www/bootstrap/app.php';
+$app->make(Illuminate\Contracts\Console\Kernel::class)->bootstrap();
+
+use Illuminate\Support\Facades\DB;
+use STS\Models\Passenger;
+
+function api(string $method, string $path, array $data = [], ?string $token = null, ?string $key = null): array
+{
+    $headers = ['Accept: application/json', 'Content-Type: application/json'];
+    if ($token !== null) $headers[] = 'Authorization: Bearer '.$token;
+    if ($key !== null) $headers[] = 'Idempotency-Key: '.$key;
+    $opts = ['http' => ['method' => $method, 'header' => implode("\r\n", $headers), 'ignore_errors' => true, 'timeout' => 30]];
+    if ($method !== 'GET') $opts['http']['content'] = json_encode($data, JSON_THROW_ON_ERROR);
+    $body = @file_get_contents('http://127.0.0.1:8000/api/mobility/commute/'.$path, false, stream_context_create($opts));
+    $status = 0;
+    foreach ($http_response_header ?? [] as $line) if (preg_match('/^HTTP\/\S+ (\d+)/', $line, $m)) $status = (int) $m[1];
+    return ['status' => $status, 'json' => json_decode($body ?: '', true)];
+}
+
+function ok(array $response, string $label): array
+{
+    if ($response['status'] !== 200) throw new RuntimeException($label.' HTTP '.$response['status']);
+    return $response['json'] ?? [];
+}
+
+function concurrentCancel(int $booking, string $token, string $trial): array
+{
+    // Do not let the parent PDO connection be inherited by forked children.
+    DB::disconnect();
+    $start = microtime(true) + 0.2;
+    $children = [];
+    foreach (['a', 'b'] as $suffix) {
+        $pair = stream_socket_pair(STREAM_PF_UNIX, STREAM_SOCK_STREAM, 0);
+        if ($pair === false) throw new RuntimeException('cannot create result pipe');
+        $pid = pcntl_fork();
+        if ($pid === -1) throw new RuntimeException('pcntl_fork failed');
+        if ($pid === 0) {
+            fclose($pair[0]);
+            while (microtime(true) < $start) usleep(500);
+            $started = microtime(true);
+            $response = api('POST', 'bookings/'.$booking.'/cancel', [], $token, 'cancel-race-'.$trial.'-'.$suffix);
+            fwrite($pair[1], json_encode(['status' => $response['status'], 'code' => $response['json']['error']['code'] ?? null, 'started' => $started, 'finished' => microtime(true)], JSON_THROW_ON_ERROR));
+            fclose($pair[1]);
+            exit(0);
+        }
+        fclose($pair[1]);
+        $children[] = [$pid, $pair[0]];
+    }
+    $responses = [];
+    foreach ($children as [$pid, $socket]) {
+        $responses[] = json_decode(stream_get_contents($socket), true, 512, JSON_THROW_ON_ERROR);
+        fclose($socket);
+        pcntl_waitpid($pid, $status);
+        if (!pcntl_wifexited($status) || pcntl_wexitstatus($status) !== 0) throw new RuntimeException('cancellation child failed');
+    }
+    return $responses;
+}
+
+$report = ['probe' => 'cancellation-concurrency-probe', 'trials' => [], 'completed' => false];
+try {
+    if (DB::connection()->getDriverName() !== 'mysql' || getenv('PHP_CLI_SERVER_WORKERS') !== '4') throw new RuntimeException('requires disposable MySQL and four HTTP workers');
+    $driver = ok(api('POST', 'demo-session', ['role' => 'driver']), 'driver session');
+    $rider = ok(api('POST', 'demo-session', ['role' => 'rider']), 'rider session');
+    $driverToken = $driver['token']; $riderToken = $rider['token'];
+    $prefs = static fn (string $role, string $time): array => ['role' => $role, 'vehicle_preference' => 'both', 'schedule_mode' => 'fixed', 'home' => ['lat' => 12.9716, 'lng' => 77.5946, 'label' => 'Demo home'], 'campus' => ['lat' => 12.9352, 'lng' => 77.62, 'label' => 'Demo campus'], 'outbound_time' => $time, 'return_time' => '17:30', 'weekdays' => [1, 2, 3, 4, 5, 6, 7]];
+    for ($i = 0; $i < 6; $i++) {
+        $date = (new DateTimeImmutable('now', new DateTimeZone('Asia/Kolkata')))->modify('+'.(20 + $i).' day')->format('Y-m-d');
+        $time = sprintf('09:%02d', $i);
+        ok(api('PUT', 'profile', $prefs('driver', $time), $driverToken, 'cancel-profile-d-'.$i), 'driver profile');
+        ok(api('PUT', 'profile', $prefs('rider', $time), $riderToken, 'cancel-profile-r-'.$i), 'rider profile');
+        ok(api('POST', 'offers', ['date' => $date, 'direction' => 'outbound', 'vehicle_type' => 'car', 'choice' => 'DIRECT_RIDER_PICKUP'], $driverToken, 'cancel-publish-'.$i), 'publish');
+        $url = 'rides?direction=outbound&date='.$date.'&start_time=08:00&end_time=10:00&vehicle_type=car';
+        $cards = ok(api('GET', $url, [], $riderToken), 'search')['data'];
+        if (!$cards) throw new RuntimeException('published ride not discoverable');
+        $card = $cards[0]; $booking = (int) ok(api('POST', 'rides/'.$card['trip_id'].'/request', ['quote_token' => $card['quote_token']], $riderToken, 'cancel-request-'.$i), 'request')['data']['booking_id'];
+        ok(api('POST', 'bookings/'.$booking.'/accept', [], $driverToken, 'cancel-accept-'.$i), 'accept');
+        $before = (int) ok(api('GET', 'wallet', [], $riderToken), 'wallet before')['available_minor'];
+        ok(api('POST', 'wallet/top-up', ['amount_minor' => 50000], $riderToken, 'cancel-topup-'.$i), 'topup');
+        ok(api('POST', 'bookings/'.$booking.'/pay', [], $riderToken, 'cancel-pay-'.$i), 'pay');
+        $responses = concurrentCancel($booking, $riderToken, (string) $i);
+        $validStatuses = array_reduce($responses, static fn (bool $ok, array $response): bool => $ok && ($response['status'] === 200 || ($response['status'] === 409 && $response['code'] === 'COMMUTE_BUSY_RETRY')), true);
+        $overlap = max(array_column($responses, 'started')) < min(array_column($responses, 'finished'));
+        if (!$validStatuses || !$overlap) throw new RuntimeException('cancellation requests were not a valid overlapping race');
+        $retries = [];
+        foreach ($responses as $n => $response) if ($response['status'] === 409 && $response['code'] === 'COMMUTE_BUSY_RETRY') $retries[] = api('POST', 'bookings/'.$booking.'/cancel', [], $riderToken, 'cancel-retry-'.$i.'-'.$n);
+        $row = DB::table('trip_passengers')->where('id', $booking)->first();
+        $hold = DB::table('mobility_commute_demo_holds')->where('booking_id', $booking)->first();
+        $refunds = DB::table('mobility_commute_demo_entries')->where('booking_id', $booking)->where('kind', 'refund')->count();
+        $after = (int) ok(api('GET', 'wallet', [], $riderToken), 'wallet after')['available_minor'];
+        $available = ok(api('GET', $url, [], $riderToken), 'search after cancel')['data'];
+        $pass = (int) ($row->request_state ?? -1) === Passenger::STATE_CANCELED && (int) ($row->canceled_state ?? -1) === Passenger::CANCELED_PASSENGER && ($hold->state ?? null) === 'refunded' && $refunds === 1 && $after === $before + 50000 && count($available) >= 1 && !array_filter($retries, static fn (array $retry): bool => $retry['status'] !== 200);
+        $report['trials'][] = ['trial' => $i + 1, 'booking_id' => $booking, 'responses' => $responses, 'retry_statuses' => array_column($retries, 'status'), 'refund_entries' => $refunds, 'overlapping_http_calls' => $overlap, 'passed' => $pass];
+        if (!$pass) throw new RuntimeException('cancellation invariant failed on trial '.($i + 1));
+    }
+    $report['completed'] = true;
+} catch (Throwable $e) {
+    $report['failure'] = $e->getMessage();
+}
+$report['all_checks_passed'] = $report['completed'] && !in_array(false, array_column($report['trials'], 'passed'), true);
+echo json_encode($report, JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES)."\n";
+exit($report['all_checks_passed'] ? 0 : 1);
