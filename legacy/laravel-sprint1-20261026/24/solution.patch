+                    $legs[] = ['distance_meters' => $distance, 'duration_seconds' => $distance ? (int) ceil($distance / ($mode === 'foot' ? 1.3 : 8)) : 0];
+                }
+                return ['provider' => 'osrm', 'profile' => 'fixture', 'data_version' => $mode.'|crop_sha256='.str_repeat('a', 64).'|profile_sha256='.str_repeat('b', 64), 'geometry' => array_map(fn ($p) => [$p['lng'], $p['lat']], $points), 'waypoints' => array_map(fn ($p) => ['location' => [$p['lng'], $p['lat']], 'distance_meters' => 0], $points), 'legs' => $legs, 'distance_meters' => array_sum(array_column($legs, 'distance_meters')), 'duration_seconds' => array_sum(array_column($legs, 'duration_seconds'))];
+            }
+        });
+    }
+
+    public function test_driver_cancels_whole_ride_atomically_and_replays_safely(): void
+    {
+        $driver = $this->demoSession('driver');
+        $rider = $this->demoSession('rider');
+        $pendingRider = $this->demoSession('rider', 'campus-route');
+        $this->profile($driver, 'driver');
+        $this->profile($rider, 'rider');
+        $this->profile($pendingRider, 'rider');
+        $date = now('Asia/Kolkata')->addDay()->toDateString();
+        $this->actingAsApiUser($driver)->postJson('/api/mobility/commute/offers', ['date' => $date, 'direction' => 'outbound', 'vehicle_type' => 'car', 'choice' => 'DIRECT_RIDER_PICKUP'], ['Idempotency-Key' => 'trip-cancel-publish'])->assertOk();
+        $card = $this->actingAsApiUser($rider)->getJson('/api/mobility/commute/rides?date='.$date.'&start_time=08:00&end_time=10:00&direction=outbound&vehicle_type=car')->assertOk()->json('data.0');
+        $booking = $this->actingAsApiUser($rider)->postJson('/api/mobility/commute/rides/'.$card['trip_id'].'/request', ['quote_token' => $card['quote_token']], ['Idempotency-Key' => 'trip-cancel-request'])->assertOk()->json('data.booking_id');
+        $pendingCard = $this->actingAsApiUser($pendingRider)->getJson('/api/mobility/commute/rides?date='.$date.'&start_time=08:00&end_time=10:00&direction=outbound&vehicle_type=car')->assertOk()->json('data.0');
+        $pendingBooking = $this->actingAsApiUser($pendingRider)->postJson('/api/mobility/commute/rides/'.$card['trip_id'].'/request', ['quote_token' => $pendingCard['quote_token']], ['Idempotency-Key' => 'trip-cancel-pending-request'])->assertOk()->json('data.booking_id');
+        $this->actingAsApiUser($driver)->postJson('/api/mobility/commute/bookings/'.$booking.'/accept', [], ['Idempotency-Key' => 'trip-cancel-accept'])->assertOk();
+        $this->actingAsApiUser($rider)->postJson('/api/mobility/commute/wallet/top-up', ['amount_minor' => 50000], ['Idempotency-Key' => 'trip-cancel-topup'])->assertOk();
+        $this->actingAsApiUser($rider)->postJson('/api/mobility/commute/bookings/'.$booking.'/pay', [], ['Idempotency-Key' => 'trip-cancel-pay'])->assertOk();
+        $path = '/api/mobility/commute/trips/'.$card['trip_id'].'/transition';
+        $this->actingAsApiUser($rider)->postJson($path, ['action' => 'cancel'], ['Idempotency-Key' => 'trip-cancel-outsider'])->assertForbidden();
+        $this->actingAsApiUser($driver)->postJson($path, ['action' => 'cancel'], ['Idempotency-Key' => 'trip-cancel-driver'])->assertOk()->assertJsonPath('state', 'cancelled');
+        $this->assertDatabaseHas('trips', ['id' => $card['trip_id'], 'state' => \STS\Models\Trip::STATE_CANCELED]);
+        $this->assertDatabaseHas('mobility_trip_lifecycles', ['trip_id' => $card['trip_id'], 'state' => 'cancelled', 'version' => 1]);
+        $this->assertDatabaseHas('mobility_trip_events', ['trip_id' => $card['trip_id'], 'action' => 'cancel', 'idempotency_key' => 'trip-cancel-driver']);
+        $this->assertDatabaseHas('trip_passengers', ['id' => $booking, 'request_state' => Passenger::STATE_CANCELED, 'canceled_state' => Passenger::CANCELED_DRIVER]);
+        $this->assertDatabaseHas('trip_passengers', ['id' => $pendingBooking, 'request_state' => Passenger::STATE_CANCELED, 'canceled_state' => Passenger::CANCELED_DRIVER]);
+        $this->assertDatabaseHas('mobility_commute_demo_holds', ['booking_id' => $booking, 'state' => 'refunded']);
+        $this->assertSame(1, DB::table('mobility_commute_demo_entries')->where('booking_id', $booking)->where('kind', 'refund')->count());
+        $this->actingAsApiUser($driver)->postJson($path, ['action' => 'cancel'], ['Idempotency-Key' => 'trip-cancel-driver'])->assertOk()->assertJsonPath('state', 'cancelled');
+        $this->assertSame(1, DB::table('mobility_trip_events')->where('trip_id', $card['trip_id'])->where('action', 'cancel')->count());
+    }
+
+    private function demoSession(string $role, ?string $scenario = null): User
+    {
+        $body = ['role' => $role];
+        if ($scenario !== null) $body['scenario'] = $scenario;
+        return User::findOrFail($this->postJson('/api/mobility/commute/demo-session', $body)->assertOk()->json('user.id'));
+    }
+
+    private function profile(User $user, string $role): void
+    {
+        $this->actingAsApiUser($user)->putJson('/api/mobility/commute/profile', ['role' => $role, 'vehicle_preference' => 'both', 'schedule_mode' => 'fixed', 'home' => ['lat' => 12.9716, 'lng' => 77.5946, 'label' => 'Demo home'], 'campus' => ['lat' => 12.9352, 'lng' => 77.62, 'label' => 'Demo campus'], 'outbound_time' => '08:30', 'return_time' => '17:30', 'weekdays' => [1, 2, 3, 4, 5, 6, 7]])->assertOk();
+    }
+}
