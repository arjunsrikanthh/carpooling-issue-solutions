+<?php
+
+namespace Tests\Feature\Mobility;
+
+use Illuminate\Database\QueryException;
+use Illuminate\Support\Facades\DB;
+use STS\Models\Passenger;
+use STS\Models\Trip;
+use STS\Models\User;
+use Tests\TestCase;
+
+final class MobilityCommuteIntegrityTest extends TestCase
+{
+    public function test_commute_tables_have_foreign_keys_and_unique_receipt_identity(): void
+    {
+        if (DB::getDriverName() !== 'mysql') {
+            $this->markTestSkipped('MySQL constraint proof is intentionally run against the disposable MySQL test database.');
+        }
+
+        $database = DB::connection()->getDatabaseName();
+        $foreignKeys = DB::table('information_schema.TABLE_CONSTRAINTS')
+            ->where('CONSTRAINT_SCHEMA', $database)
+            ->where('CONSTRAINT_TYPE', 'FOREIGN KEY')
+            ->whereIn('TABLE_NAME', [
+                'mobility_commute_profiles', 'mobility_commute_demo_actors', 'mobility_commute_demo_trips',
+                'mobility_commute_demo_wallets', 'mobility_commute_demo_holds', 'mobility_commute_demo_entries',
+                'mobility_commute_receipts',
+            ])->pluck('CONSTRAINT_NAME')->all();
+
+        $this->assertNotEmpty($foreignKeys);
+        $this->assertContains('commute_profiles_user_fk', $foreignKeys);
+        $this->assertContains('commute_demo_holds_booking_fk', $foreignKeys);
+        $this->assertContains('commute_demo_entries_booking_fk', $foreignKeys);
+
+        $this->assertGreaterThanOrEqual(2, DB::table('information_schema.STATISTICS')
+            ->where('TABLE_SCHEMA', $database)->where('TABLE_NAME', 'mobility_commute_receipts')
+            ->where('INDEX_NAME', 'mobility_commute_receipts_user_id_key_hash_unique')->count());
+        $checks = DB::table('information_schema.TABLE_CONSTRAINTS')
+            ->where('CONSTRAINT_SCHEMA', $database)->where('CONSTRAINT_TYPE', 'CHECK')
+            ->pluck('CONSTRAINT_NAME')->all();
+        $this->assertContains('commute_demo_trips_vehicle_ck', $checks);
+        $this->assertContains('commute_demo_holds_state_ck', $checks);
+        $this->assertContains('commute_demo_entries_kind_ck', $checks);
+        $this->assertSame('YES', DB::table('information_schema.COLUMNS')->where('TABLE_SCHEMA', $database)
+            ->where('TABLE_NAME', 'mobility_commute_demo_trips')->where('COLUMN_NAME', 'audience_id')->value('IS_NULLABLE'));
+    }
+
+    public function test_orphan_demo_wallet_and_negative_hold_are_rejected_by_mysql(): void
+    {
+        if (DB::getDriverName() !== 'mysql') {
+            $this->markTestSkipped('MySQL constraint proof is intentionally run against the disposable MySQL test database.');
+        }
+
+        $this->expectException(QueryException::class);
+        DB::table('mobility_commute_demo_wallets')->insert([
+            'user_id' => 2147483000,
+            'available_minor' => 0,
+            'created_at' => now(),
+            'updated_at' => now(),
+        ]);
+    }
+
+    public function test_valid_hold_cannot_use_negative_amount_or_unknown_state(): void
+    {
+        if (DB::getDriverName() !== 'mysql') {
+            $this->markTestSkipped('MySQL constraint proof is intentionally run against the disposable MySQL test database.');
+        }
+        $driver = User::factory()->create();
+        $rider = User::factory()->create();
+        $trip = Trip::factory()->create(['user_id' => $driver->id]);
+        $booking = Passenger::factory()->create(['trip_id' => $trip->id, 'user_id' => $rider->id]);
+        $this->expectException(QueryException::class);
+        DB::table('mobility_commute_demo_holds')->insert([
+            'booking_id' => $booking->id,
+            'rider_id' => $rider->id,
+            'driver_id' => $driver->id,
+            'amount_minor' => -1,
+            'state' => 'held',
+            'created_at' => now(),
+            'updated_at' => now(),
+        ]);
+    }
+
+    public function test_commute_trigger_accepts_rider_and_rejects_self_booking_and_invalid_state(): void
+    {
+        if (DB::getDriverName() !== 'mysql') {
+            $this->markTestSkipped('MySQL trigger proof is intentionally run against the disposable MySQL test database.');
+        }
+        $driver = User::factory()->create();
+        $rider = User::factory()->create();
+        $trip = Trip::factory()->create(['user_id' => $driver->id]);
+        DB::table('mobility_commute_demo_trips')->insert(['trip_id' => $trip->id, 'audience_id' => null, 'fixture_key' => hash('sha256', 'trigger-'.$trip->id), 'vehicle_type' => 'car', 'is_publication' => true, 'direction' => 'outbound', 'fare_minor' => 0, 'base_fare_minor' => 0, 'surcharge_minor' => 0, 'journey' => '{}', 'created_at' => now(), 'updated_at' => now()]);
+        $valid = DB::table('trip_passengers')->insertGetId(['trip_id' => $trip->id, 'user_id' => $rider->id, 'passenger_type' => Passenger::TYPE_PASAJERO, 'request_state' => Passenger::STATE_PENDING]);
+        $this->assertDatabaseHas('trip_passengers', ['id' => $valid, 'request_state' => Passenger::STATE_PENDING]);
+        $conductor = DB::table('trip_passengers')->insertGetId(['trip_id' => $trip->id, 'user_id' => $driver->id, 'passenger_type' => Passenger::TYPE_CONDUCTOR, 'request_state' => Passenger::STATE_PENDING]);
+        $this->assertDatabaseHas('trip_passengers', ['id' => $conductor, 'passenger_type' => Passenger::TYPE_CONDUCTOR]);
+        try {
+            DB::table('trip_passengers')->insertGetId(['trip_id' => $trip->id, 'user_id' => $driver->id, 'passenger_type' => Passenger::TYPE_PASAJERO, 'request_state' => Passenger::STATE_PENDING]);
+            $this->fail('self-booking trigger did not reject the insert');
+        } catch (QueryException $e) {
+            $this->assertStringContainsString('COMMUTE_SELF_BOOKING', $e->getMessage());
+            $this->assertSame('45000', $e->errorInfo[0]);
+        }
+        try {
+            DB::table('trip_passengers')->insertGetId(['trip_id' => $trip->id, 'user_id' => User::factory()->create()->id, 'passenger_type' => Passenger::TYPE_PASAJERO, 'request_state' => 99]);
+            $this->fail('invalid booking state trigger did not reject the insert');
+        } catch (QueryException $e) {
+            $this->assertStringContainsString('COMMUTE_INVALID_BOOKING_STATE', $e->getMessage());
+            $this->assertSame('45000', $e->errorInfo[0]);
+        }
+        foreach ([['request_state' => 99], ['user_id' => $driver->id]] as $invalidUpdate) {
+            try {
+                DB::table('trip_passengers')->where('id', $valid)->update($invalidUpdate);
+                $this->fail('commute update trigger did not reject invalid data');
+            } catch (QueryException $e) {
+                $this->assertSame('45000', $e->errorInfo[0]);
+            }
+            $this->assertDatabaseHas('trip_passengers', ['id' => $valid, 'user_id' => $rider->id, 'request_state' => Passenger::STATE_PENDING]);
+        }
+    }
+
+    public function test_commute_wallet_balance_check_rejects_negative_balance(): void
+    {
+        if (DB::getDriverName() !== 'mysql') {
+            $this->markTestSkipped('MySQL check proof is intentionally run against the disposable MySQL test database.');
+        }
+        $user = User::factory()->create();
+        $this->expectException(QueryException::class);
+        DB::table('mobility_commute_demo_wallets')->insert(['user_id' => $user->id, 'available_minor' => -1, 'created_at' => now(), 'updated_at' => now()]);
+    }
+}
